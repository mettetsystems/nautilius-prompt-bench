# Shared Podman network for Nautilius Prompting Workbench container units.
# Install: scripts/install-quadlets.sh --method containers

[Unit]
Description=Nautilius Prompting Workbench Podman network
Before=prompt-piper-postgres.service prompt-piper-api.service prompt-piper-web.service

[Network]
NetworkName=prompt-piper

[Install]
WantedBy=default.target
