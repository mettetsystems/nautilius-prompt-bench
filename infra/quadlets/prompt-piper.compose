# Run the full Nautilius Prompting Workbench stack via podman compose (recommended Quadlet method).
# Install: scripts/install-quadlets.sh --method compose
#
# Build images once before first start:
#   podman compose -f infra/podman-compose.yml build

[Unit]
Description=Nautilius Prompting Workbench (Podman Compose stack)
Documentation=file://%h/nautilius-prompt-bench/infra/quadlets/README.md
After=network-online.target
Wants=network-online.target

[Compose]
File=%h/nautilius-prompt-bench/infra/podman-compose.yml
WorkingDirectory=%h/nautilius-prompt-bench

[Service]
Restart=always

[Install]
WantedBy=default.target
