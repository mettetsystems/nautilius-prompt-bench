# Nautilius native Mac profile
# M3 / 16 GB unified RAM: light model, 4096-token total context.
API_HOST=127.0.0.1
API_PORT=8010
DATABASE_URL=sqlite:///./data/prompt_piper.db
PROMPT_PIPER_LLM_ENABLED=true
PROMPT_PIPER_AUTO_START_LLM=true
PROMPT_PIPER_ALLOW_CPU_LLM=false
PROMPT_PIPER_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
PROMPT_PIPER_LOCAL_CHAT_MODEL=Qwen3-1.7B-Q8_0.gguf
PROMPT_PIPER_LOCAL_MODEL_PRESET=qwen3-1.7b
PROMPT_PIPER_LOCAL_MODEL_PATH=./data/models/Qwen3-1.7B-Q8_0.gguf
PROMPT_PIPER_LOCAL_MODEL_GGUF_REPO=Qwen/Qwen3-1.7B-GGUF
PROMPT_PIPER_LOCAL_MODEL_GGUF_FILE=Qwen3-1.7B-Q8_0.gguf
PROMPT_PIPER_LLAMA_N_CTX=4096
PROMPT_PIPER_LLM_TIMEOUT_SECONDS=120
PROMPT_PIPER_EMBEDDING_DEVICE=cpu
PROMPT_PIPER_EXTERNAL_INFERENCE_ENABLED=false
PROMPT_PIPER_EXTERNAL_ENABLED=false
PROMPT_PIPER_CLARIFICATION_ENABLED=false
