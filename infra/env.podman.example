# Container stack environment (copy values into .env at repo root).
# Do not commit real secrets. Defaults below are for local development only.

# --- PostgreSQL (postgres service) ---
POSTGRES_USER=prompt_piper
POSTGRES_PASSWORD=prompt_piper
POSTGRES_DB=prompt_piper

# --- API (api service) ---
# Overridden in infra/podman-compose.yml to use the postgres service hostname.
# DATABASE_URL=postgresql+psycopg://prompt_piper:prompt_piper@postgres:5432/prompt_piper

# Documents export mount: host ~/Documents/Nautilius -> container /exports
PROMPT_PIPER_EXPORT_ROOT=/exports
PROMPT_PIPER_HOST_EXPORT_ROOT=${HOME}/Documents/Nautilius
PROMPT_PIPER_REGISTRY_ROOT=/exports/registry
PROMPT_PIPER_ARTIFACT_ROOT=/exports/exports
PROMPT_PIPER_MODEL_CACHE=/models
AUDIT_LOG_PATH=/exports/audit

# Hugging Face / sentence-transformers model cache (bind-mounted volume)
HF_HOME=/models
TRANSFORMERS_CACHE=/models
SENTENCE_TRANSFORMERS_HOME=/models
PROMPT_PIPER_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Local OpenAI-compatible model on the host (llama.cpp, vLLM, etc.)
# From inside containers, use host.containers.internal (Podman on Fedora).
PROMPT_PIPER_LOCAL_BASE_URL=http://host.containers.internal:8080/v1
PROMPT_PIPER_LOCAL_CHAT_MODEL=llama
PROMPT_PIPER_LOCAL_EMBED_MODEL=llama

# External inference stays off unless you explicitly opt in.
PROMPT_PIPER_EXTERNAL_INFERENCE_ENABLED=false
PROMPT_PIPER_EXTERNAL_ENABLED=false
# PROMPT_PIPER_EXTERNAL_API_KEY=

# --- Web (web service build arg) ---
# Browser-facing API URL (must be reachable from your machine, not from inside web container).
VITE_API_BASE_URL=http://127.0.0.1:8010
