# Nautilius Prompting Workbench — copy to .env and adjust for local development

# --- API ---
API_HOST=127.0.0.1
API_PORT=8010
API_RELOAD=true

# Database: sqlite (default for local dev) or postgresql
DATABASE_URL=sqlite:///./data/prompt_piper.db
# DATABASE_URL=postgresql+psycopg://prompt_piper:prompt_piper@localhost:5432/prompt_piper

# Storage (native dev: repo-local paths below; Podman uses ~/Documents/Nautilius)
REGISTRY_PATH=./data/registry
ARTIFACTS_PATH=./data/artifacts
AUDIT_LOG_PATH=./data/audit
SESSIONS_PATH=./data/sessions
USER_SETTINGS_PATH=./data/user_settings.json
LEXICON_VECTOR_INDEX_PATH=./data/lexicon/precision_vectors.json
PROMPT_PIPER_MODEL_CACHE=./data/model-cache

# Documents export layout (enable for Podman / host-visible exports)
# PROMPT_PIPER_EXPORT_ROOT=~/Documents/Nautilius
# PROMPT_PIPER_HOST_EXPORT_ROOT=~/Documents/Nautilius
# PROMPT_PIPER_REGISTRY_ROOT=~/Documents/Nautilius/registry
# PROMPT_PIPER_ARTIFACT_ROOT=~/Documents/Nautilius/exports

# --- Web (native ports differ from PromptPiper: 8010 / 5174 so the apps do not share origin or API) ---
WEB_PORT=5174
VITE_API_BASE_URL=http://127.0.0.1:8010

# --- PostgreSQL (Podman compose) ---
POSTGRES_USER=prompt_piper
POSTGRES_PASSWORD=prompt_piper
POSTGRES_DB=prompt_piper

# Podman full stack (see infra/env.podman.example):
# DATABASE_URL=postgresql+psycopg://prompt_piper:prompt_piper@localhost:5432/prompt_piper
# PROMPT_PIPER_EXPORT_ROOT=/exports
# PROMPT_PIPER_HOST_EXPORT_ROOT=${HOME}/Documents/Nautilius
# HF_HOME=/models
# TRANSFORMERS_CACHE=/models
# SENTENCE_TRANSFORMERS_HOME=/models

# --- Local LLM (OpenAI-compatible, e.g. llama.cpp server) ---
# Run `make setup` for an interactive wizard (CPU-only, Gemma 3, Qwen3, or custom endpoint).
# `make ensure-llm` auto-starts llama-server when a CUDA/ROCm GPU is available; otherwise CPU-only.
# Set PROMPT_PIPER_ALLOW_CPU_LLM=true to run llama.cpp on CPU when no GPU is present.
# PROMPT_PIPER_AUTO_START_LLM=true
# PROMPT_PIPER_ALLOW_CPU_LLM=false
# PROMPT_PIPER_LLAMA_GPU_LAYERS=999   # omit to auto-tune from free/detected VRAM
# PROMPT_PIPER_LLAMA_N_CTX=4096       # omit to auto-tune from free/detected VRAM
# PROMPT_PIPER_LLM_TIMEOUT_SECONDS=120
# LLAMA_SERVER=/usr/bin/llama-server
# PROMPT_PIPER_LLM_ENABLED=false disables the chat model (rule-based fallbacks only).
PROMPT_PIPER_LLM_ENABLED=true
PROMPT_PIPER_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
PROMPT_PIPER_LOCAL_CHAT_MODEL=llama
PROMPT_PIPER_LOCAL_EMBED_MODEL=llama
# PROMPT_PIPER_LOCAL_MODEL_PRESET=gemma3-1b
# PROMPT_PIPER_LOCAL_MODEL_PATH=./data/models/gemma-3-1b-it-Q4_K_M.gguf
# PROMPT_PIPER_LOCAL_MODEL_GGUF_REPO=google/gemma-3-1b-it-qat-q4_0-gguf
# PROMPT_PIPER_LOCAL_MODEL_GGUF_FILE=gemma-3-1b-it-q4_0.gguf
# GGUF downloads: make setup-model-deps  (installs hf via huggingface_hub[cli])
# PROMPT_PIPER_LOCAL_API_KEY=

# External inference is disabled unless explicitly enabled.
PROMPT_PIPER_EXTERNAL_INFERENCE_ENABLED=false
PROMPT_PIPER_EXTERNAL_ENABLED=false
# REQUIRE_APPROVAL_BEFORE_EXTERNAL_CALL=true
# PROMPT_PIPER_EXTERNAL_BASE_URL=https://api.openai.com/v1
# PROMPT_PIPER_EXTERNAL_CHAT_MODEL=gpt-4o-mini
# PROMPT_PIPER_EXTERNAL_EMBED_MODEL=text-embedding-3-small
# PROMPT_PIPER_EXTERNAL_API_KEY=

# PROMPT_PIPER_LLM_ENABLED=true
# PROMPT_PIPER_MODEL_PROFILE=compatibility   # size-aware max_tokens also uses LOCAL_MODEL_PRESET

# --- Local similarity search ---
PROMPT_PIPER_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# cpu avoids VRAM contention with llama and supports older GPUs (e.g. GTX 1050)
PROMPT_PIPER_EMBEDDING_DEVICE=cpu
# PROMPT_PIPER_EMBEDDING_FALLBACK=false
# SIMILARITY_INDEX_PATH=./data/similarity_index.json
# SIMILARITY_WARNING_THRESHOLD=0.90

# Optional dedicated clarification endpoint (never automatically downloaded/launched).
PROMPT_PIPER_CLARIFICATION_ENABLED=false
PROMPT_PIPER_CLARIFICATION_MODEL=DeepSeek-R1-Distill-Qwen-32B
PROMPT_PIPER_CLARIFICATION_BASE_URL=http://127.0.0.1:8081/v1
PROMPT_PIPER_CLARIFICATION_TIMEOUT=180
